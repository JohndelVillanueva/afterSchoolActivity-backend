model usersession {
  id                  Int                 @id @default(autoincrement())
  userId              Int
  activityId          Int
  sessionId           Int
  sessionsPurchased   Int                 @default(0)
  sessionsAttended    Int                 @default(0)
  sessionsRemaining   Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  user                user                @relation(fields: [userId], references: [id], map: "UserSession_userId_fkey")
  afterschoolactivity afterschoolactivity @relation(fields: [activityId], references: [id], map: "UserSession_activityId_fkey")
  activitysession     activitysession     @relation(fields: [sessionId], references: [id], map: "UserSession_sessionId_fkey")

  @@unique([userId, activityId], map: "UserSession_userId_activityId_key")
  @@index([userId], map: "UserSession_userId_fkey")
  @@index([activityId], map: "UserSession_activityId_fkey")
  @@index([sessionId], map: "UserSession_sessionId_fkey")
}

model wispay {
  id           Int      @id @default(autoincrement())
  debit        Decimal  @db.Decimal(10, 2)
  credit       Decimal  @db.Decimal(10, 2)
  rfid         BigInt
  empid        String   @db.Text
  username     String   @db.VarChar(255)
  refcode      String   @db.Text
  transdate    DateTime @db.DateTime(0)
  processedby  String   @db.Text
  product_type String   @db.VarChar(255)
  product_name String   @db.VarChar(255)
  quantity     Float    @db.Float
  isAfterSchoolPayment Boolean @default(false)
}